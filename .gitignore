# ---------------------------------------------------------------------------
# This repo contains configuration sources. Runtime data belongs in the normal
# XDG locations and should not be added here.
# ---------------------------------------------------------------------------

# --- browser / Electron / Chromium-based app profiles ----------------------
Cider/
Code/
Code\ -\ OSS/
google-chrome-for-testing/
mozilla/
Postman/
Antigravity/
Electron/
Docker\ Desktop/
opencode/
posting/
ngrok/
wasistlos/

# --- runtime / state (not config) ------------------------------------------
dconf/
pulse/
qalculate/
kwalletrc
go/
lazygit/
uv/
yay/
zed/
featherpad/
obs-studio/

# tmux plugins are installed by TPM/Ansible in ~/.tmux, never from this repo.
# Keep accidental checkouts under the repo from being versioned.
tmux/plugins/
# Spicetify and Vesktop themes live outside this repository and are generated
# by Matugen.

# --- generated / caches ----------------------------------------------------
wallpapers/current_image*
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zhistory
hypr/current_wallpaper

# --- real secrets (template *.example stays tracked) -----------------------
nvim/lua/secrets.lua

# --- generic credential files ----------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.crt
*.token
*credentials*
.env
.env.*
id_rsa*
id_ed25519*
id_ecdsa*

# --- editor / OS noise -----------------------------------------------------
.DS_Store
*.swp
*.swo
*~
__pycache__/
*.pyc
