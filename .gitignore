# ---------------------------------------------------------------------------
# This repo doubles as $XDG_CONFIG_HOME, so apps may write runtime data and
# even browser profiles in here. Ignore anything that isn't actual config.
# ---------------------------------------------------------------------------

# --- browser / Electron / Chromium-based app profiles ----------------------
BraveSoftware/
Cider/
Code/
Code\ -\ OSS/
discord/
google-chrome-for-testing/
mozilla/
Postman/
Antigravity/
Electron/
Docker\ Desktop/
session/
opencode/
posting/
ngrok/
wasistlos/

# --- runtime / state (not config) ------------------------------------------
dconf/
pulse/
qalculate/
kwalletrc
go/
uv/
yay/
zed/
featherpad/
obs-studio/
# spicetify/Themes/text/ is regenerated by matugen, but matugen needs the
# parent path to exist, so we keep it (color.ini is harmless theme data).

# --- generated / caches ----------------------------------------------------
wallpapers/current_image*
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zhistory
hypr/current_wallpaper

# --- real secrets (template *.example stays tracked) -----------------------
nvim/lua/secrets.lua

# --- generic credential files ----------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.crt
*.token
*credentials*
.env
.env.*
id_rsa*
id_ed25519*
id_ecdsa*

# --- editor / OS noise -----------------------------------------------------
.DS_Store
*.swp
*.swo
*~
